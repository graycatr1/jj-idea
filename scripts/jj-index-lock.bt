// Observe lock syscalls system-wide; the Python reader resolves relative paths and filters roots.
// Arguments are captured only for jj/git executables, to attribute short-lived processes.
tracepoint:syscalls:sys_enter_execve
/strcontains(str(args.filename), "/jj") || strcontains(str(args.filename), "/git")/
{
    @tracked[pid] = 1;
    printf("EXEC\t%llu\t%d\t%d\t%s\t", nsecs, pid, ((struct task_struct *)curtask)->real_parent->tgid, str(args.filename));
    join(args.argv);
}

tracepoint:syscalls:sys_enter_open
/strcontains(str(args.filename), "index.lock")/
{
    @tracked[pid] = 1;
    @open[tid] = 1;
    printf("OPEN\t%llu\t%d\t%d\t%s\t-100\t%d\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, args.flags, str(args.filename), tid);
}
tracepoint:syscalls:sys_enter_openat2
/strcontains(str(args.filename), "index.lock")/
{
    @tracked[pid] = 1;
    @open[tid] = 1;
    printf("OPEN\t%llu\t%d\t%d\t%s\t%d\t%llu\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, args.dfd,
        *(uint64 *)uptr(args.how), str(args.filename), tid);
}

tracepoint:syscalls:sys_enter_openat
/strcontains(str(args.filename), "index.lock")/
{
    @tracked[pid] = 1;
    @open[tid] = 1;
    printf("OPEN\t%llu\t%d\t%d\t%s\t%d\t%d\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, args.dfd, args.flags, str(args.filename), tid);
}
tracepoint:syscalls:sys_exit_open,tracepoint:syscalls:sys_exit_openat,tracepoint:syscalls:sys_exit_openat2
/@open[tid]/
{
    printf("OPEN_RESULT\t%llu\t%d\t%d\t%lld\n", nsecs, pid, tid, args.ret);
    $deleted = delete(@open, tid);
}

tracepoint:syscalls:sys_enter_unlink
/strcontains(str(args.pathname), "index.lock")/
{
    @tracked[pid] = 1;
    @unlink[tid] = 1;
    printf("UNLINK\t%llu\t%d\t%d\t%s\t-100\t0\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, str(args.pathname), tid);
}
tracepoint:syscalls:sys_enter_unlinkat
/strcontains(str(args.pathname), "index.lock")/
{
    @tracked[pid] = 1;
    @unlink[tid] = 1;
    printf("UNLINK\t%llu\t%d\t%d\t%s\t%d\t0\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, args.dfd, str(args.pathname), tid);
}
tracepoint:syscalls:sys_exit_unlink,tracepoint:syscalls:sys_exit_unlinkat
/@unlink[tid]/
{
    printf("UNLINK_RESULT\t%llu\t%d\t%d\t%lld\n", nsecs, pid, tid, args.ret);
    $deleted = delete(@unlink, tid);
}

tracepoint:syscalls:sys_enter_rename
/strcontains(str(args.oldname), "index.lock")/
{
    @tracked[pid] = 1;
    @rename[tid] = 1;
    printf("RENAME\t%llu\t%d\t%d\t%s\t-100\t0\t%s\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, str(args.oldname), str(args.newname), tid);
}
tracepoint:syscalls:sys_enter_renameat,tracepoint:syscalls:sys_enter_renameat2
/strcontains(str(args.oldname), "index.lock")/
{
    @tracked[pid] = 1;
    @rename[tid] = 1;
    printf("RENAME\t%llu\t%d\t%d\t%s\t%d\t0\t%s\t%s\t%d\n", nsecs, pid,
        ((struct task_struct *)curtask)->real_parent->tgid, comm, args.olddfd, str(args.oldname), str(args.newname), tid);
}
tracepoint:syscalls:sys_exit_rename,tracepoint:syscalls:sys_exit_renameat,tracepoint:syscalls:sys_exit_renameat2
/@rename[tid]/
{
    printf("RENAME_RESULT\t%llu\t%d\t%d\t%lld\n", nsecs, pid, tid, args.ret);
    $deleted = delete(@rename, tid);
}

tracepoint:syscalls:sys_enter_kill
/@tracked[args.pid]/
{
    printf("SIGNAL\t%llu\t%d\t%d\t%d\n", nsecs, pid, args.pid, args.sig);
}
tracepoint:sched:sched_process_exit
/@tracked[pid] && pid == tid/
{
    printf("EXIT\t%llu\t%d\t%d\n", nsecs, pid, ((struct task_struct *)curtask)->exit_code);
    $deleted = delete(@tracked, pid);
}
END { clear(@tracked); clear(@open); clear(@unlink); clear(@rename); }
